{
  "name": "plantilladocumentacion",
  "version": "1.0.0",
  "description": "Backend III - Testing y Escalabilidad - Entrega Final",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "mocha test/**/*.test.js --exit --timeout 15000",
    "test:adoptions": "mocha test/adoptions/adoptions.test.js --exit --timeout 15000",
    "test:pets": "mocha test/pets/pets.test.js --exit --timeout 15000",
    "test:sessions": "mocha test/sessions/auth.test.js --exit --timeout 15000",
    "test:users": "mocha test/users/users.test.js --exit --timeout 15000",
    "test:mocks": "mocha test/mocks/mocking.test.js --exit --timeout 15000",
    "test:utils": "mocha test/utils/mocking.test.js --exit --timeout 15000",
    "test:all": "npm run test:adoptions && npm run test:pets && npm run test:sessions && npm run test:users && npm run test:mocks",
    "docker:build": "docker build -t backend3-entrega-final .",
    "docker:run": "docker run -p 8080:8080 --env-file .env backend3-entrega-final",
    "docker:push": "docker tag backend3-entrega-final fi93/backend3-entrega-final:latest && docker push fi93/backend3-entrega-final:latest",
    "docker:compose": "docker-compose up",
    "docker:compose:build": "docker-compose up --build",
    "docker:compose:clean": "docker-compose down -v --remove-orphans",
    "lint": "eslint src/**/*.js",
    "swagger": "node -e \"console.log('📚 Swagger disponible en: http://localhost:8080/api-docs')\"",
    "fix:tests": "npm run test:all -- --reporter spec"
  },
  "keywords": [
    "backend",
    "testing",
    "mongodb",
    "express",
    "nodejs",
    "docker",
    "swagger"
  ],
  "author": "Franco Iarlori",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "eslint": "^9.10.0",
    "mongodb-memory-server": "^10.1.3",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.2",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "tar": "^7.5.3",
    "diff": "^8.0.3",
    "@mapbox/node-pre-gyp": "^2.0.0"
  },
  "resolutions": {
    "tar": "^7.5.3",
    "diff": "^8.0.3",
    "@mapbox/node-pre-gyp": "^2.0.0"
  }
}