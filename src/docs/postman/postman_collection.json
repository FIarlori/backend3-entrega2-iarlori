  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log('🚀 Ejecutando request: ' + pm.request.method + ' ' + pm.request.url.toString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tests básicos para validar respuestas",
          "pm.test(\"Status code is 2xx\", function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});",
          "",
          "// Para respuestas JSON, validar estructura básica",
          "if (pm.response.headers.get(\"Content-Type\").includes(\"application/json\")) {",
          "    const jsonData = pm.response.json();",
          "    ",
          "    pm.test(\"Response has JSON body\", function () {",
          "        pm.expect(jsonData).to.be.an(\"object\");",
          "    });",
          "    ",
          "    // Validar estructura común de éxito",
          "    if (jsonData.status === \"success\") {",
          "        pm.test(\"Success response structure\", function () {",
          "            pm.expect(jsonData).to.have.property(\"status\", \"success\");",
          "        });",
          "    }",
          "    ",
          "    // Validar estructura común de error",
          "    if (jsonData.status === \"error\") {",
          "        pm.test(\"Error response structure\", function () {",
          "            pm.expect(jsonData).to.have.property(\"status\", \"error\");",
          "            pm.expect(jsonData).to.have.property(\"error\");",
          "        });",
          "    }",
          "}",
          "",
          "// Guardar IDs dinámicos para uso posterior",
          "if (pm.response.code === 200 && pm.response.headers.get(\"Content-Type\").includes(\"application/json\")) {",
          "    const jsonData = pm.response.json();",
          "    ",
          "    // Guardar user_id si está disponible",
          "    if (jsonData.payload && jsonData.payload._id && pm.request.url.toString().includes(\"/users\")) {",
          "        pm.collectionVariables.set(\"user_id\", jsonData.payload._id);",
          "        console.log(\"✅ User ID guardado: \" + jsonData.payload._id);",
          "    }",
          "    ",
          "    // Guardar pet_id si está disponible",
          "    if (jsonData.payload && jsonData.payload._id && pm.request.url.toString().includes(\"/pets\")) {",
          "        pm.collectionVariables.set(\"pet_id\", jsonData.payload._id);",
          "        console.log(\"✅ Pet ID guardado: \" + jsonData.payload._id);",
          "    }",
          "    ",
          "    // Guardar adoption_id si está disponible",
          "    if (jsonData.payload && jsonData.payload._id && pm.request.url.toString().includes(\"/adoptions\")) {",
          "        pm.collectionVariables.set(\"adoption_id\", jsonData.payload._id);",
          "        console.log(\"✅ Adoption ID guardado: \" + jsonData.payload._id);",
          "    }",
          "}"
        ]
      }
    }
